# Server Configuration
PORT=8000
NODE_ENV=development
# Exact browser origins allowed to call public API endpoints.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://sugikaran-dev.netlify.app,https://sugikaran-dev-admin.netlify.app
# Only admin dashboard origins may access admin login/logout and mutate admin data.
ADMIN_ORIGINS=http://localhost:5173,https://sugikaran-dev-admin.netlify.app


# Database Connection (Prisma)
# Replace with your actual Neon/PostgreSQL connection string
DATABASE_URL="postgresql://johndoe:mypassword@localhost:5432/mydb?schema=public"
# DIRECT_URL is used by Prisma for migrations (if pooling is enabled in DATABASE_URL)
DIRECT_URL="postgresql://johndoe:mypassword@localhost:5432/mydb?schema=public"

# Authentication uses random per-session cookie values; only SHA-256 hashes are stored.

# Only needed when deliberately creating the initial admin account with the seed script.
# Keep these out of frontend env files and never commit real values.
# ADMIN_SEED_EMAIL=admin@example.com
# ADMIN_SEED_PASSWORD=replace-with-a-unique-long-password

# Optional GA4 dashboard integration. Set all three or leave all unset.
# GA4_PROPERTY_ID=123456789
# GA4_CLIENT_EMAIL=analytics-reader@your-google-project.iam.gserviceaccount.com
# GA4_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_PRIVATE_KEY_CONTENT\n-----END PRIVATE KEY-----\n"
