# Server Configuration
PORT=8000
NODE_ENV=development

# Database Connection (Prisma)
# Replace with your actual Neon/PostgreSQL connection string
DATABASE_URL="postgresql://johndoe:mypassword@localhost:5432/mydb?schema=public"
# DIRECT_URL is used by Prisma for migrations (if pooling is enabled in DATABASE_URL)
DIRECT_URL="postgresql://johndoe:mypassword@localhost:5432/mydb?schema=public"

# Authentication Security
# These secrets are used to sign and verify your JWTs and secure cookies.
# In production, replace these with long, cryptographically secure random strings.
JWT_SECRET="super-secret-jwt-key-replace-me-in-production"
COOKIE_SECRET="super-secret-cookie-key-replace-me-in-production"

# Optional GA4 dashboard integration. Copy these to your local .env or hosting
# environment only after replacing them with real credentials. Set all three.
# GA4_PROPERTY_ID=123456789
# GA4_CLIENT_EMAIL=analytics-reader@your-google-project.iam.gserviceaccount.com
# GA4_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_PRIVATE_KEY_CONTENT\n-----END PRIVATE KEY-----\n"
